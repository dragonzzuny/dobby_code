# Runtime state: regenerated, machine-specific, may embed absolute paths
.dobby/state/
.dobby/backups/
.dobby/knowledge/kg.bootstrap.json
.dobby/inventory.json
.dobby/memory/
.dobby/compression_guideline.json
.dobby/specialization.json
reports/LEDGER_*.md

# Never commit credentials
*.env
.api-keys*
*.pem
*.key

__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
Thumbs.db
*.tmp

# OMC / agent-runtime session state (not part of the product)
.omc/
.claude/settings.local.json

# Packaging output. Added with `pyproject.toml`: `python -m build` leaves these
# in the working tree, they are regenerated from source every time, and a
# repository that tracked them would be shipping a stale copy of itself.
build/
dist/
*.egg-info/

# Scratch lists a chunked test run writes into the repo root. They exist for
# seconds and were committed by accident once; a pattern is cheaper than
# remembering to delete them.
/[a-z][0-9].txt
